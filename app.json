{
    "expo": {
        "name": "Infinity",
        "slug": "infinity",
        "scheme": "infinity",
        "orientation": "portrait",
        "userInterfaceStyle": "automatic",
        "platforms": [
            "ios",
            "android"
        ],
        "assetBundlePatterns": [
            "**/*"
        ],
        "icon": "src/assets/infinity.png",
        "updates": {
            "enabled": true,
            "checkAutomatically": "ON_LOAD",
            "fallbackToCacheTimeout": 0
        },
        "plugins": [
            "expo-router",
            "expo-asset",
            "expo-font",
            "expo-updates"
        ],
        "experiments": {
            "typedRoutes": true
        },
        "android": {
            "package": "com.kurisani.infinity2048"
        },
        "newArchEnabled": true
    }
}