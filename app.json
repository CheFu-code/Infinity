{
  "expo": {
    "name": "Infinity",
    "slug": "infinity",
    "version": "1.0.2",
    "scheme": "infinity",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "src/assets/logo.png",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/3f9617ae-4c7d-430e-8a22-48902524e2bf",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "runtimeVersion": "1.0.2",
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-updates",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "infinity",
          "organization": "chefu-technologies"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "co.za.chefu.infinity",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "src/assets/icon-logo.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3f9617ae-4c7d-430e-8a22-48902524e2bf"
      }
    },
    "owner": "chefu"
  }
}
